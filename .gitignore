# --- competition data: large, and not ours to redistribute -------------------
data/
public/
public_new/

# --- generated artefacts -----------------------------------------------------
work/out/
*.tar.gz
*.log

# --- the engine binaries ship with the competition's sample submission --------
# (libcg.so / cg.dll). Excluded so this repo redistributes no competition
# binaries; restore them from the sample submission to run anything locally.
work/lib/cg/

# --- environment -------------------------------------------------------------
.venv/
__pycache__/
*.pyc
*.pyo

# --- local scratch -----------------------------------------------------------
# Root-anchored: this rule exists for the scratch deck.csv that agents v14-v34
# wrote into the repo root at import. Unanchored it also matched
# work/agents/*/deck.csv, so NO agent's decklist was ever tracked and no bundle
# in this repo could be reconstructed from git.
/deck.csv
*.tmp
